# Local dev (langgraph dev) — align with langgraph-server/.env
LANGGRAPH_API_URL=http://127.0.0.1:2024

# langgraph up / Compose
# LANGGRAPH_API_URL=http://127.0.0.1:8123

# Optional API keys (local dev usually does not require)
# LANGGRAPH_API_KEY=
# LANGSMITH_API_KEY=

# Step 5 — sync (incremental, retry, chunking, rate limit)
# LANGGRAPH_SYNC_INCREMENTAL=1
# LANGGRAPH_SYNC_STATE_PATH=.cache/langgraph_sync_state.json
# LANGGRAPH_SYNC_MAX_RETRIES=3
# LANGGRAPH_SYNC_RETRY_DELAYS=0.5,1.0,2.0
# LANGGRAPH_SYNC_RETRY_EXPONENTIAL=1
# LANGGRAPH_SYNC_RETRY_JITTER=1
# LANGGRAPH_SYNC_CHUNK_MAX_ENTITIES=500
# LANGGRAPH_SYNC_CHUNK_MAX_EDGES=500
# LANGGRAPH_SYNC_MIN_INTERVAL_SEC=0.2
# LANGGRAPH_SYNC_INTERVAL_SEC=60

# Agent LLM narrative — Qwen via DashScope (official OpenAI-compatible API)
# SENTINEL_LLM_ENABLED=1
# DASHSCOPE_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SENTINEL_LLM_MODEL=qwen3.6-plus
# SENTINEL_LLM_ENABLE_THINKING=0
# SENTINEL_LLM_TIMEOUT_SEC=60
# SENTINEL_LLM_LIVE=1

# Agent action layer (phase F) — default dry-run simulated; live K8s not wired
# SENTINEL_EXECUTE_LIVE=0
