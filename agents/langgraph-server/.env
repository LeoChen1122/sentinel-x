# Local dev default (langgraph dev)
LANGGRAPH_API_URL=http://127.0.0.1:2024

# Docker compose (langgraph up) - use port 8123
# LANGGRAPH_API_URL=http://127.0.0.1:8123

# Optional: OpenAI / LLM keys if graph nodes need them
# OPENAI_API_KEY=

# Optional: LangSmith tracing
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
