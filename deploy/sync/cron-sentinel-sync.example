# Sentinel-X K8s sync -> /etc/cron.d/sentinel-sync (chmod 644, LF line endings only)

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every 5 minutes (kube-system default namespace from sync-k8s.env)
*/5 * * * * root /usr/local/bin/sentinel-sync-k8s.sh >/dev/null 2>&1

# W26: sentinel-sandbox (crash-demo fixture) — offset 2 min to avoid sync lock
2-59/5 * * * * root env SENTINEL_SYNC_ENV=/etc/sentinel/sync-k8s.env NAMESPACE=sentinel-sandbox /usr/local/bin/sentinel-sync-k8s.sh >/dev/null 2>&1

# W7: inspect patrol (3 min after sync window)
5-59/5 * * * * root /usr/local/bin/sentinel-inspect-patrol.sh >>/var/log/sentinel-patrol.log 2>&1
