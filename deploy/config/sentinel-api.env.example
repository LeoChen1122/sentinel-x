# Sentinel-X API (W7) — copy to /etc/sentinel/sentinel-api.env
SENTINEL_ROOT=/opt/sentinel-x
LANGGRAPH_API_URL=http://127.0.0.1:2024
LANGGRAPH_THREAD_ID=AUTO
CLUSTER_ID=k3s-prod
NAMESPACE=kube-system
# Optional Bearer auth (empty = no auth; bind localhost only)
# SENTINEL_API_TOKEN=
SENTINEL_PATROL_DRY_RUN=true
