# Sentinel-X server master env — copy to /etc/sentinel/sentinel-x.env
# Used by sentinel-config-discover.sh + sentinel-config-apply.sh
# LF only; if uploaded from Windows: sed -i 's/\r$//' /etc/sentinel/sentinel-x.env
#
# AUTO or empty = discover --write may overwrite on install/apply
# Explicit values are preserved across discover

SENTINEL_ROOT=/opt/sentinel-x

CLUSTER_ID=k3s-prod
NAMESPACE=kube-system
# TENANT_ID=

LANGGRAPH_API_URL=http://127.0.0.1:2024
LANGGRAPH_THREAD_ID=AUTO

MCP_K8S_CONTAINER=AUTO
MCP_PROM_CONTAINER=AUTO

K3S_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
KUBECONFIG_TARGET=/root/.kube/config
KUBECONFIG_SERVER=host-ip

PROMETHEUS_BASE_URL=AUTO
KUBE_PROM_NODE_PORT=30909

LANGGRAPH_SYNC_STATE_PATH=/var/lib/sentinel/sync-state
LANGGRAPH_SYNC_INCREMENTAL=1
SENTINEL_SYNC_LOG=/var/log/sentinel-sync.log
SENTINEL_PROM_SYNC_LOG=/var/log/sentinel-prom-sync.log
STREAMLIT_PORT=8501

# W5 Skills
SENTINEL_SKILLS_DIR=/opt/sentinel-x/skills
SENTINEL_SKILLS_DB=/opt/sentinel-x/skills/.index/skills.db
SENTINEL_SKILLS_RECORD=1
SENTINEL_SKILLS_SEARCH_LIMIT=3

# W6 Sandbox
SENTINEL_SANDBOX_ENABLED=1
SENTINEL_SANDBOX_NAMESPACE=sentinel-sandbox
SENTINEL_SANDBOX_IMAGE=sentinel-x-sandbox:latest
SENTINEL_SANDBOX_AUDIT_DIR=/opt/sentinel-x/sandbox/audit

# W7 Patrol
SENTINEL_PATROL_ENABLED=1
SENTINEL_PATROL_COOLDOWN_SEC=3600
SENTINEL_PATROL_DRY_RUN=true
SENTINEL_PATROL_STATE_PATH=/var/lib/sentinel/inspect-patrol-state.json
SENTINEL_PATROL_LOG=/var/log/sentinel-patrol.log
SENTINEL_PATROL_EXTRA_NAMESPACES=sentinel-sandbox
# SENTINEL_PATROL_NAMESPACES=kube-system,sentinel-sandbox

# W7 API (optional --with-api)
# SENTINEL_API_TOKEN=
SENTINEL_API_HOST=127.0.0.1:8080
